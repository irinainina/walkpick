<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" stops the cloud backup but not a phone-to-phone copy; Supabase is the only copy. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
